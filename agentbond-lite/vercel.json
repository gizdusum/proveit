{
  "version": 2,
  "routes": [
    { "src": "/api/config", "dest": "/api/config.js" },
    { "src": "/api/demo/task", "dest": "/api/demo-task.js" },
    { "src": "/api/ai/report", "dest": "/api/ai-report.js" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
